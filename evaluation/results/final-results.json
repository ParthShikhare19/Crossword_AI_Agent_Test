      "turns": [
        {
          "turn": 1,
          "user": "Do you ship internationally?",
          "answer": "Yes-Aster & Row ships internationally, but only to Canada. Shipping to any other country is not available at this time.  \n\nSource: 06-international-shipping.md - \"Supported destinations\"",
          "sources": [
            {
              "filename": "06-international-shipping.md",
